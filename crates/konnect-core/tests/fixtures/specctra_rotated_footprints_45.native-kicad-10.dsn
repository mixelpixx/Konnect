(pcb board.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "10.0.6-1.fc44")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  130000 -70000  80000 -70000  80000 -30000  130000 -30000
            130000 -70000)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 200)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component Resistor_SMD:R_0402
      (place R1 100000 -50000 front 90 (PN 10k))
    )
    (component Resistor_SMD:R_0402::1
      (place R2 110000 -50000 front 0 (PN 4.7k))
    )
    (component Resistor_SMD:R_0402::2
      (place R4 120000 -60000 front 90 (PN 4.7k))
    )
    (component Resistor_SMD:R_0402::3
      (place R3 120000 -40000 front 45 (PN 4.7k))
    )
  )
  (library
    (image Resistor_SMD:R_0402
      (pin Rect[T]Pad_600.000000x500.000000_um (rotate 12.3457) 1 -500 0)
      (pin Rect[T]Pad_600.000000x500.000000_um (rotate 12.3457) 2 500 0)
    )
    (image Resistor_SMD:R_0402::1
      (pin Rect[T]Pad_600.000000x500.000000_um 1 -500 0)
      (pin Rect[T]Pad_600.000000x500.000000_um 2 500 0)
    )
    (image Resistor_SMD:R_0402::2
      (pin Rect[T]Pad_600.000000x500.000000_um (rotate 90) 1 -500 0)
      (pin Rect[T]Pad_600.000000x500.000000_um (rotate 270) 2 500 0)
    )
    (image Resistor_SMD:R_0402::3
      (pin Rect[T]Pad_600.000000x500.000000_um 1 -499.999 0)
      (pin Rect[T]Pad_600.000000x500.000000_um 2 499.999 0)
    )
    (padstack Rect[T]Pad_600.000000x500.000000_um
      (shape (rect F.Cu -300 -250 300 250))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net VCC
      (pins R1-1 R2-2 R4-2 R3-1)
    )
    (net GND
      (pins R1-2 R2-1 R4-1 R3-2)
    )
    (class kicad_default GND VCC
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
